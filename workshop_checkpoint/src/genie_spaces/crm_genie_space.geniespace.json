  "instructions": {
    "example_question_sqls": [
      {
        "id": "01f18f1029ab1b50b351097a6d4619fc",
        "question": [
          "How many leads and distinct companies are there for each sales stage in the CRM data?"
        ],
        "sql": [
          "SELECT\n",
          "  stage,\n",
          "  COUNT(*) AS num_leads,\n",
          "  COUNT(DISTINCT company) AS num_companies\n",
          "FROM IDENTIFIER(:catalog || '.' || :schema_prefix || '_silver.crm_silver')\n",
          "GROUP BY stage\n",
          "ORDER BY num_leads DESC"
        ]
      }
    ]
